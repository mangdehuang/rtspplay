{
  "name": "rtspplay-live",
  "version": "1.0.0",
  "description": "实时 RTSP 视频流播放器，支持 JSMpeg 和 MSE 两种模式，延迟 1-3 秒",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rtsp",
    "video",
    "player",
    "live",
    "streaming",
    "jsmpeg",
    "mse",
    "websocket",
    "real-time"
  ],
  "author": "mangdehuang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mangdehuang/rtspplay.git",
    "directory": "packages/rtspplay-live"
  },
  "bugs": {
    "url": "https://github.com/mangdehuang/rtspplay/issues"
  },
  "homepage": "https://github.com/mangdehuang/rtspplay/tree/main/packages/rtspplay-live#readme",
  "dependencies": {
    "@cycjimmy/jsmpeg-player": "^6.0.5"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^20.0.0",
    "rollup": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  }
}
